var _radioSSE = null;
var _radioYtPlayer = null;
var _radioYtReady = false;
var _radioDucking = false;
var _radioMuted = false;
var _radioCurrentUser = null;

// Load YouTube IFrame API once
function _radioLoadYtApi(){
