function loadRow(url, rowId, count, setHero, _attempt){
  _attempt = _attempt || 0;
  fetch(url).then(function(r){
    if(!r.ok) throw new Error('HTTP '+r.status);
    return r.json();
  }).then(function(d){
    var items=(d.results||[]).slice(0,count);
    var row=document.getElementById(rowId); if(!row) return;
    row.innerHTML='';
    if(!items.length){ row.innerHTML='<div style="color:var(--dm);padding:.5rem;font-size:.8rem">Sin contenido disponible</div>'; return; }
    items.forEach(function(it,i){
      var mt=normType(it.media_type||(url.indexOf('/movie/')>-1?'movie':'tv'));
      var obj=tmdbObj(it,mt);
      if(setHero&&i===0) setHeroItem(obj);
      row.appendChild(mkCard(obj));
    });
  }).catch(function(e){
    if(_attempt < 2){ setTimeout(function(){ loadRow(url, rowId, count, setHero, _attempt+1); }, 1500*(_attempt+1)); }
    else { var row=document.getElementById(rowId); if(row) row.innerHTML=''; }
  });
}
