// ✅ FIXED: Removed syntax errors from toast function
function toast(msg, type){
  var old=document.querySelector('.toast'); 
  if(old) old.remove();
  var t=document.createElement('div'); 
  t.className='toast';
  if(type==='error') t.style.borderColor='rgba(248,113,113,.5)';
  else if(type==='ok') t.style.borderColor='rgba(74,222,128,.4)';
  t.textContent=msg;
  document.body.appendChild(t);
  setTimeout(function(){ 
    t.style.opacity='0'; 
    t.style.transition='opacity .4s'; 
    setTimeout(function(){ 
      if(t.parentNode) t.remove(); 
    }, 400); 
  }, 3000);
}

