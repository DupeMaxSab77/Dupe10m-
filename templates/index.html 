// ===================== PLAYER =====================
function playItem(item){
  S.curItem=item; S.srcIdx=0;
  S.seasonEpsCount={};
  show('player', true);
  document.getElementById('ptitle').textContent=item.title;
  updFavBtns(item.tmdb_id);
  document.getElementById('srcPanel').classList.remove('vis');
  document.getElementById('srcPanel').innerHTML='';
  setVld(true); document.getElementById('pif').src='about:blank';

  // Start playing immediately — fetch imdbID in parallel (non-blocking)
  doPlay(item);

  if(!item.imdbID && !STANDALONE){
    fetch(BASE+'/api/tmdb-detail?tmdb_id='+item.tmdb_id+'&media_type='+normType(item.type))
    .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
    .then(function(d){
      if(d.ok && d.detail){
        if(d.detail.imdbID){ item.imdbID=d.detail.imdbID; if(S.curItem&&S.curItem.tmdb_id===item.tmdb_id) S.curItem.imdbID=d.detail.imdbID; }
        if(d.detail.totalSeasons){ item.totalSeasons=d.detail.totalSeasons; if(S.curItem&&S.curItem.tmdb_id===item.tmdb_id) S.curItem.totalSeasons=d.detail.totalSeasons; }
      }
    }).catch(function(e){ console.warn('tmdb-detail fetch failed:', e); });
  }
}

function doPlay(item){
  if(isTv(item)){
    var prog=getProgress(item.tmdb_id);
    S.curSeason=prog ? parseInt(prog.season)||1 : 1;
    S.curEp=prog ? parseInt(prog.episode)||1 : 1;
    loadEps(item, S.curSeason, true);
  } else {
    document.getElementById('eppan').classList.remove('vis');
    document.getElementById('epctrl').classList.remove('vis');
    loadMovEmbed(item);
    addHist(item, null, null);
  }
}

function loadMovEmbed(item){
  setVld(true);
  var url=getEmbedUrl(item, null, null);
  if(!url || url==='about:blank'){
    setVld(false);
    if(!STANDALONE) toast('Cambiá de fuente para ver esta película', 'error');
    return;
  }
  document.getElementById('pif').src=url;
}


