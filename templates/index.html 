}

function _radioConnectSSE(){
  if(_radioSSE){ _radioSSE.close(); }
  _radioSSE = new EventSource(BASE + '/api/radio/sse');

  _radioSSE.addEventListener('state', function(e){
    var st = JSON.parse(e.data);
    _radioApplyState(st);
  });
  _radioSSE.addEventListener('link', function(e){
    var d = JSON.parse(e.data);
    _radioSetVdoLink(d.link);
  });
  _radioSSE.addEventListener('duck', function(e){
    var d = JSON.parse(e.data);
    _radioDuckApply(d.ducking);
  });
  _radioSSE.addEventListener('chat', function(e){
    var d = JSON.parse(e.data);
    _radioChatAppend(d);
  });
  _radioSSE.addEventListener('suggestion', function(e){
    var d = JSON.parse(e.data);
    _radioSuggestionAdd(d);
  });
  _radioSSE.addEventListener('play', function(e){
    var d = JSON.parse(e.data);
    radioLoadYtUrl(d.url);
  });
  _radioSSE.onerror = function(){
    setTimeout(_radioConnectSSE, 3000);
  };
}

function _radioApplyState(st){
  // VDO link
  if(st.vdo_link) _radioSetVdoLink(st.vdo_link);
  // Duck
  _radioDuckApply(st.ducking);
  // Chat history
  var log = document.getElementById('radioChatLog');
  log.innerHTML = '';
  (st.chat || []).forEach(function(m){ _radioChatAppend(m, true); });
  log.scrollTop = log.scrollHeight;
  // Suggestions
  (st.suggestions || []).forEach(function(s){ _radioSuggestionAdd(s, true); });
}

function _radioSetVdoLink(link){
  var iframe = document.getElementById('radioVdoIframe');
  var status = document.getElementById('radioVoiceStatus');
  var badge = document.getElementById('radioOnAirBadge');
  if(link){
    // Append audio-only params
    var url = link + (link.includes('?') ? '&' : '?') + 'view&audioonly&nocamera&autoplay&noui=1';
    iframe.src = url;
    status.textContent = '🎙️ Voz en vivo activa.';
    status.style.color = '#4ade80';
    badge.style.display = 'inline-block';
  } else {
    iframe.src = 'about:blank';
    status.textContent = 'Sin stream de voz activo.';
    status.style.color = '';
    badge.style.display = 'none';
  }
  // Update admin input if admin
  var inp = document.getElementById('radioVdoInput');
  if(inp && !inp.value) inp.value = link;
}

function _radioDuckApply(ducking){
  _radioDucking = ducking;
  var banner = document.getElementById('radioDuckBanner');
  var btn = document.getElementById('radioDuckBtn');
  if(ducking){
    if(banner) banner.style.display = 'block';
    if(btn){ btn.textContent = '🎙️ Modo Locución (ON)'; btn.style.background='var(--red)'; btn.style.color='#fff'; }
    if(_radioYtPlayer && _radioYtPlayer.setVolume) _radioYtPlayer.setVolume(20);
  } else {
    if(banner) banner.style.display = 'none';
    if(btn){ btn.textContent = '🎙️ Modo Locución (OFF)'; btn.style.background=''; btn.style.color=''; }
    if(_radioYtPlayer && _radioYtPlayer.setVolume && !_radioMuted) _radioYtPlayer.setVolume(100);
  }
}

function _radioChatAppend(entry, noScroll){
  var log = document.getElementById('radioChatLog');
  if(!log) return;
  var div = document.createElement('div');
  div.style.cssText = 'font-size:.82rem;line-height:1.4;word-break:break-word';
  var isYt = /https?:\/\/(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)/.test(entry.message);
  var msgHtml = esc(entry.message);
  if(isYt) msgHtml = '<span style="color:#4ade80">🎵 ' + msgHtml + '</span>';
  div.innerHTML = '<span style="color:var(--red);font-weight:700">' + esc(entry.user) + '</span>'
    + '<span style="color:var(--dm)">: </span>' + msgHtml;
  log.appendChild(div);
  if(!noScroll) log.scrollTop = log.scrollHeight;
}

function _radioSuggestionAdd(sg, skipDupe){
  // Admin list
  var adminList = document.getElementById('radioSuggestions');
  var pubList = document.getElementById('radioSuggestionsPublicList');

  function mkSgEl(list, sg, isAdmin){
    // Remove placeholder
    var ph = list.querySelector('[data-placeholder]');
    if(ph) ph.remove();
    // Check dupe
    if(list.querySelector('[data-url="' + sg.url + '"]')) return;
    var d = document.createElement('div');
    d.setAttribute('data-url', sg.url);
    d.style.cssText = 'display:flex;gap:.4rem;align-items:center;background:rgba(255,255,255,.04);border-radius:var(--r);padding:.4rem .6rem;font-size:.78rem';
    var ytId = (sg.url.match(/(?:v=|youtu\.be\/)([\w\-]+)/) || [])[1] || '';
    d.innerHTML = (ytId ? '<img src="https://img.youtube.com/vi/'+ytId+'/default.jpg" style="width:48px;height:34px;object-fit:cover;border-radius:4px;flex-shrink:0">' : '')
      + '<div style="flex:1;min-width:0"><div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--txt2)">' + esc(sg.url) + '</div>'
      + '<div style="color:var(--dm);font-size:.7rem">por ' + esc(sg.user) + '</div></div>'
      + (isAdmin ? '<button class="sg-play-btn" style="padding:3px 8px;background:var(--red);border:none;border-radius:4px;color:#fff;font-size:.7rem;cursor:pointer;flex-shrink:0">▶</button>'
                  + '<button class="sg-del-btn" style="padding:3px 6px;border:1px solid var(--bdr);border-radius:4px;background:transparent;color:var(--mt);font-size:.7rem;cursor:pointer;flex-shrink:0">✕</button>'
                 : '');
    // Attach click handlers safely (avoids quoting issues)
    if(isAdmin){
      var pb=d.querySelector('.sg-play-btn'), db=d.querySelector('.sg-del-btn');
      if(pb) pb.onclick=function(e){e.stopPropagation();radioPlaySuggestion(sg.url);};
      if(db) db.onclick=function(e){e.stopPropagation();radioClearSuggestion(sg.url,db);};
    }
    list.insertBefore(d, list.firstChild);
  }

  if(adminList && S.user === 'BAUTIXD') mkSgEl(adminList, sg, true);
  if(pubList) mkSgEl(pubList, sg, false);
}

