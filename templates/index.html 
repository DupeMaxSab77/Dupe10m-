//  ANILIST LOOKUP — fetches AniList ID from TMDB title
// ══════════════════════════════════════════════════════
var _aniCache = {}; // tmdb_id -> anilistId (or null)

function isAnime(item){
  // TMDB genre 16 = Animation, genre tags include 'Animation'
  if(item.anilistId) return true;
  if(item.genres && item.genres.indexOf('Animation') > -1) return true;
  return false;
}

function fetchAnilistId(item, callback){
  var key = String(item.tmdb_id);
  if(_aniCache[key] !== undefined){ callback(_aniCache[key]); return; }

  var title = item.title||'';
  var isMovie = !isTv(item);
  var query = `query($search:String,$type:MediaType){Media(search:$search,type:$type){id idMal title{romaji english}}}`;
  var vars = { search: title, type: 'ANIME' };

  fetch('https://graphql.anilist.co', {
    method:'POST',
    headers:{'Content-Type':'application/json','Accept':'application/json'},
    body: JSON.stringify({query:query, variables:vars})
  })
  .then(function(r){ return r.json(); })
  .then(function(d){
    var id = (d.data && d.data.Media && d.data.Media.id) || null;
    _aniCache[key] = id;
    if(id) item.anilistId = id;
    callback(id);
  })
  .catch(function(){ _aniCache[key]=null; callback(null); });
}

function getEmbedUrl(item, s, e){
  var m=!isTv(item);
  var imdb=item.imdbID||'';
  var tmdb=item.tmdb_id;
  var season=s||1, ep=e||1;

  // ── 0: VidSrc ──
  if(S.srcIdx===0){
    if(m) return 'https://vidsrc.xyz/embed/movie/'+tmdb;
    return 'https://vidsrc.xyz/embed/tv/'+tmdb+'/'+season+'/'+ep;
  }
  // ── 1: VidSrc.me ──
  if(S.srcIdx===1){
    if(m) return 'https://vidsrc.me/embed/movie?tmdb='+tmdb;
    return 'https://vidsrc.me/embed/tv?tmdb='+tmdb+'&season='+season+'&episode='+ep;
  }
  // ── 2: VidPlus ──
  if(S.srcIdx===2){
    var aid=item.anilistId||null;
    if(aid){
      if(m) return 'https://player.vidplus.to/embed/anime/'+aid+'/1?dub=false';
      return 'https://player.vidplus.to/embed/anime/'+aid+'/'+ep+'?dub=false';
    }
    if(m) return 'https://player.vidplus.to/embed/movie/'+tmdb;
    return 'https://player.vidplus.to/embed/tv/'+tmdb+'/'+season+'/'+ep;
  }
  // ── 3: Videasy ──
  if(S.srcIdx===3){
    if(m) return 'https://player.videasy.net/movie/'+tmdb;
    return 'https://player.videasy.net/tv/'+tmdb+'/'+season+'/'+ep;
  }
  // ── 4: VidFast ──
  if(S.srcIdx===4){
    if(m) return 'https://vidfast.pro/movie/'+tmdb+'?autoPlay=true&server='+_vidfastServer+'&sub=es';
    return 'https://vidfast.pro/tv/'+tmdb+'/'+season+'/'+ep+'?autoPlay=true&server='+_vidfastServer+'&sub=es&nextButton=true&autoNext=true';
  }
  // ── 5: VidSrc.vip ──
  if(S.srcIdx===5){
    if(m) return 'https://vidsrc.vip/embed/movie/'+tmdb;
    return 'https://vidsrc.vip/embed/tv/'+tmdb+'/'+season+'/'+ep;
  }
  // ── 6: Rive ──
  if(S.srcIdx===6){
    if(m) return 'https://rivestream.net/embed?type=movie&id='+tmdb;
    return 'https://rivestream.net/embed?type=tv&id='+tmdb+'&season='+season+'&episode='+ep;
  }
  // ── 7: Mapple ──
  if(S.srcIdx===7){
    if(m) return 'https://mappletv.uk/watch/movie/'+tmdb;
    return 'https://mappletv.uk/watch/tv/'+tmdb+'-'+season+'-'+ep;
  }
  // ── 8: VidRock ──
  if(S.srcIdx===8){
    if(m) return 'https://vidrock.ru/movie/'+tmdb;
    return 'https://vidrock.ru/tv/'+tmdb+'/'+season+'/'+ep;
  }
  // ── 9: Spanish ──
  if(S.srcIdx===9){
    if(m) return 'https://peachify.top/embed/movie/'+tmdb+'?autoplay=true&sub=spanish&dub=spanish';
    return 'https://peachify.top/embed/tv/'+tmdb+'/'+season+'/'+ep+'?autoplay=true&sub=spanish&dub=spanish';
  }
  // Fallback
  if(m) return 'https://vidsrc.xyz/embed/movie/'+tmdb;
  return 'https://vidsrc.xyz/embed/tv/'+tmdb+'/'+season+'/'+ep;
}

// ===================== EPISODES (TMDB + IMDB) =====================
function loadEps(item, season, autoPlay){
  setVld(true);
  document.getElementById('eppan').classList.add('vis');
  document.getElementById('epctrl').classList.add('vis');

  // Show loading state in episode list
  var list=document.getElementById('eplist');
  list.innerHTML='<div class="ep-loading"><div class="sp"></div> Cargando episodios...</div>';

  // Ensure we have imdbID
  if(!item.imdbID && !STANDALONE){
    fetch(BASE+'/api/tmdb-detail?tmdb_id='+item.tmdb_id+'&media_type='+normType(item.type))
    .then(function(r){return r.json();}).then(function(d){
      if(d.ok&&d.detail){
        if(d.detail.imdbID){ item.imdbID=d.detail.imdbID; S.curItem.imdbID=d.detail.imdbID; }
        if(d.detail.totalSeasons){ item.totalSeasons=d.detail.totalSeasons; S.curItem.totalSeasons=d.detail.totalSeasons; }
      }
      doLoadEps(item, season, autoPlay);
    }).catch(function(){ doLoadEps(item, season, autoPlay); });
  } else {
    doLoadEps(item, season, autoPlay);
  }
}

function doLoadEps(item, season, autoPlay){
  // Try TMDB season details first (rich episode data: thumbnails, plot, runtime, rating)
  var tmdbUrl='https://api.themoviedb.org/3/tv/'+item.tmdb_id+'/season/'+season+'?api_key='+S.TMDB;

  fetch(tmdbUrl)
  .then(function(r){
    if(!r.ok) throw new Error('TMDB season '+r.status);
    return r.json();
  })
  .then(function(tmdbSeason){
    // TMDB returned season data
    var tmdbEps=(tmdbSeason.episodes||[]).map(function(ep){
      return {
        Episode: ep.episode_number,
        Title: ep.name || '',
        Plot: ep.overview || '',
        Runtime: ep.runtime ? ep.runtime+' min' : '',
        Rating: ep.vote_average ? ep.vote_average.toFixed(1) : '',
        Poster: ep.still_path ? S.TIMG+'/w300'+ep.still_path : '',
        Released: ep.air_date || ''
      };
    });

    S.curEps=tmdbEps;
    S.totalS=item.totalSeasons || tmdbSeason._meta_total_seasons || S.totalS || 1;
    S.curSeason=season;
    S.seasonEpsCount[season]=tmdbEps.length;

    // Build the rich episode panel
    buildEpPanel(item);
    if(autoPlay && S.curEps.length){
      var ei=Math.max(0, Math.min(S.curEp-1, S.curEps.length-1));
      playEp(item, S.curEps[ei]);
    } else if(!S.curEps.length){
      setVld(false);
      list.innerHTML='<div class="ep-empty"><i class="fa-solid fa-film" style="font-size:1.4rem;margin-bottom:.5rem;display:block;opacity:.4"></i>Sin episodios para esta temporada</div>';
    }
  })
  .catch(function(err){
    // TMDB failed — fallback to server API (IMDB-based)
    if(STANDALONE){
      setVld(false);
      document.getElementById('eplist').innerHTML='<div class="ep-empty"><i class="fa-solid fa-film" style="font-size:1.4rem;margin-bottom:.5rem;display:block;opacity:.4"></i>Sin episodios para esta temporada.</div>';
      return;
    }
    var apiType=normType(item.type);
    fetch(BASE+'/api/tmdb-episodes?tmdb_id='+item.tmdb_id+'&season='+season+'&media_type='+apiType)
    .then(function(r){return r.json();}).then(function(d){
      if(d.ok){
        S.curEps=d.episodes||[];
        S.totalS=d.totalSeasons||1;
        S.curSeason=season;
        S.seasonEpsCount[season]=S.curEps.length;
        buildEpPanel(item);
        if(autoPlay&&S.curEps.length){
          var ei=Math.max(0,Math.min(S.curEp-1,S.curEps.length-1));
          playEp(item, S.curEps[ei]);
        } else if(!S.curEps.length){
          setVld(false);
          document.getElementById('eplist').innerHTML='<div class="ep-empty"><i class="fa-solid fa-film" style="font-size:1.4rem;margin-bottom:.5rem;display:block;opacity:.4"></i>Sin episodios para esta temporada</div>';
        }
      } else {
        setVld(false);
        document.getElementById('eplist').innerHTML='<div class="ep-empty">Error al cargar episodios</div>';
        toast('Error al cargar episodios');
      }
    }).catch(function(){
      setVld(false);
      document.getElementById('eplist').innerHTML='<div class="ep-empty">Error de conexión</div>';
      toast('Error de conexión');
    });
  });
}

// Fetch total seasons from TMDB if unknown
function fetchTotalSeasons(item){
  if(item.totalSeasons) return Promise.resolve(item.totalSeasons);
  return fetch('https://api.themoviedb.org/3/tv/'+item.tmdb_id+'?api_key='+S.TMDB)
  .then(function(r){return r.json();})
  .then(function(d){
    var ts=d.number_of_seasons || 1;
    item.totalSeasons=ts;
    S.curItem.totalSeasons=ts;
    return ts;
  })
  .catch(function(){ return 1; });
}

function buildEpPanel(item){
  var list=document.getElementById('eplist');
  document.getElementById('eptitle').innerHTML='Episodios <span class="ep-count" id="epCount">'+S.curEps.length+' eps</span>';

  // Ensure we know total seasons
  fetchTotalSeasons(item).then(function(totalS){
    S.totalS=totalS;
    var tabs=document.getElementById('stabs');
    tabs.innerHTML='';
    for(var s=1; s<=S.totalS; s++){
      (function(sn){
        var b=document.createElement('button');
        b.className='stab'+(sn===S.curSeason ? ' on' : '');
        b.textContent='T'+sn;
        var count=S.seasonEpsCount[sn];
        if(count) b.setAttribute('data-count', count);
        else b.setAttribute('data-count', '');
        b.onclick=function(){ loadEps(item, sn, false); };
        tabs.appendChild(b);
      })(s);
    }

    // Update nav button labels
    updNavLabels();
  });

  // Render episode list (rich cards)
  list.innerHTML='';
  if(!S.curEps.length){
    list.innerHTML='<div class="ep-empty"><i class="fa-solid fa-film" style="font-size:1.4rem;margin-bottom:.5rem;display:block;opacity:.4"></i>Sin episodios para esta temporada</div>';
    return;
  }

  S.curEps.forEach(function(ep, idx){
    var epNum=parseInt(ep.Episode)||0;
    var isCurrent=epNum===S.curEp;
    var div=document.createElement('div');
    div.className='ep-item'+(isCurrent ? ' on' : '');
    div.setAttribute('data-ep', epNum);

    var thumbHtml='';
    if(ep.Poster){
      thumbHtml='<div class="ep-thumb"><img src="'+ep.Poster+'" alt="" loading="lazy" onerror="this.parentElement.innerHTML=\'<span class=ep-thumb-fallback><i class=fa-solid fa-play></i></span>\'"/><div class="ep-play-icon"><i class="fa-solid fa-play"></i></div></div>';
    } else {
      thumbHtml='<div class="ep-thumb"><span class="ep-thumb-fallback"><i class="fa-solid fa-play"></i></span><div class="ep-play-icon"><i class="fa-solid fa-play"></i></div></div>';
    }

    var metaParts=[];
    if(ep.Runtime) metaParts.push('<span><i class="fa-regular fa-clock" style="font-size:.6rem"></i> '+esc(ep.Runtime)+'</span>');
    if(ep.Rating) metaParts.push('<span class="ep-rating"><i class="fa-solid fa-star"></i> '+esc(ep.Rating)+'</span>');
    if(ep.Released) metaParts.push('<span>'+esc(ep.Released.slice(0,4))+'</span>');

    div.innerHTML=thumbHtml+
      '<div class="ep-info">'+
        '<div class="ep-num">Episodio '+epNum+'</div>'+
        '<div class="ep-name">'+esc(ep.Title || 'Episodio '+epNum)+'</div>'+
        (metaParts.length ? '<div class="ep-meta">'+metaParts.join('<span style="color:var(--bdr)">·</span>')+'</div>' : '')+
        (ep.Plot ? '<div class="ep-plot">'+esc(ep.Plot)+'</div>' : '')+
      '</div>'+
      (isCurrent ? '<div class="ep-now-badge">Reproduciendo</div>' : '');

    div.onclick=function(){ playEp(item, ep); };
    list.appendChild(div);
  });

  // Update nav buttons
  document.getElementById('epPrev').disabled=(S.curEp<=1 && S.curSeason<=1);
  document.getElementById('epNext').disabled=(S.curEp>=S.curEps.length && S.curSeason>=S.totalS);
  document.getElementById('epPrev2').disabled=document.getElementById('epPrev').disabled;
  document.getElementById('epNext2').disabled=document.getElementById('epNext').disabled;
  document.getElementById('epPrev').onclick=function(){ navEp(item, -1); };
  document.getElementById('epNext').onclick=function(){ navEp(item, 1); };
  document.getElementById('epPrev2').onclick=function(){ navEp(item, -1); };
  document.getElementById('epNext2').onclick=function(){ navEp(item, 1); };

  // Scroll to current episode
  if(S.curEp>0){
    setTimeout(function(){
      var activeEl=list.querySelector('.ep-item.on');
      if(activeEl) activeEl.scrollIntoView({behavior:'smooth', block:'nearest'});
    }, 100);
  }
}

function updNavLabels(){
  var prevLbl=document.getElementById('epPrevLbl');
  var nextLbl=document.getElementById('epNextLbl');
  if(prevLbl){
    if(S.curEp>1){
      prevLbl.textContent='E'+(S.curEp-1);
    } else if(S.curSeason>1){
      var prevCount=S.seasonEpsCount[S.curSeason-1];
      prevLbl.textContent='T'+(S.curSeason-1)+(prevCount ? 'E'+prevCount : '');
    } else {
      prevLbl.textContent='Ant';
    }
  }
  if(nextLbl){
    if(S.curEp<S.curEps.length){
      nextLbl.textContent='E'+(S.curEp+1);
    } else if(S.curSeason<S.totalS){
      nextLbl.textContent='T'+(S.curSeason+1)+'E1';
    } else {
      nextLbl.textContent='Sig';
    }
  }
}

function playEp(item, ep){
  S.curEp=parseInt(ep.Episode)||1;
  document.getElementById('ptitle').textContent=item.title+' — T'+S.curSeason+'E'+S.curEp+(ep.Title?' · '+ep.Title:'');
  setVld(true);
  var url=getEmbedUrl(item, S.curSeason, S.curEp);
  document.getElementById('pif').src=url||'about:blank';
  saveProgress(item, S.curSeason, S.curEp);
  addHist(item, S.curSeason, S.curEp);
  updFavBtns(item.tmdb_id);

  // Update active state in list
  document.querySelectorAll('.ep-item').forEach(function(el){
    var num=parseInt(el.getAttribute('data-ep'))||0;
    var wasOn=el.classList.contains('on');
    el.classList.toggle('on', num===S.curEp);
    // Remove/add "Reproduciendo" badge
    var badge=el.querySelector('.ep-now-badge');
    if(num===S.curEp && !badge){
      var b=document.createElement('div'); b.className='ep-now-badge'; b.textContent='Reproduciendo';
      el.appendChild(b);
    } else if(num!==S.curEp && badge){
      badge.remove();
    }
    // Re-trigger glow animation on new active
    if(num===S.curEp && !wasOn){
      el.style.animation='none';
      el.offsetHeight; // force reflow
      el.style.animation='';
    }
  });

  // Scroll active into view
  var activeEl=document.querySelector('.ep-item.on');
  if(activeEl) activeEl.scrollIntoView({behavior:'smooth', block:'nearest'});

  updNavLabels();
}

function navEp(item, dir){
  var ne=S.curEp+dir;
  if(ne<1){
    // Go to previous season's last episode
    if(S.curSeason>1){
      S.curSeason--;
      loadEps(item, S.curSeason, true).then(function(){
        if(S.curEps.length){
          S.curEp=S.curEps.length;
          playEp(item, S.curEps[S.curEps.length-1]);
        }
      });
    }
    return;
  }
  if(ne>S.curEps.length){
    // Go to next season's first episode
    if(S.curSeason<S.totalS){
      S.curSeason++;
      S.curEp=1;
