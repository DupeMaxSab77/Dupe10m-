  fetch(BASE+'/api/cuevana-search', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({query:q})})
  .then(function(r){return r.json();}).then(function(d){if(d.job_id) pollSL(d.job_id,'search',null); else setSLSt('Error al buscar.', false);})
  .catch(function(){setSLSt('Error de conexión.', false);});}
function pollSL(jid, act, extra){
  S.slJobId=jid;
  (function loop(i){
    if(i>=60){ setSLSt('La operación tardó demasiado. Intentá de nuevo.', false); return; }
    var delay = i < 5 ? 800 : (i < 20 ? 1000 : 1500); // backoff
    setTimeout(function(){
      if(S.slJobId!==jid) return;
      fetch(BASE+'/api/job-status/'+jid)
      .then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
      .then(function(d){
        setSLSt((d.progress||'Procesando...')+' ', true);
        if(d.state==='done'){
          setSLSt('', false);
          if(act==='search') renderSLR(d.results||[]);
          else if(act==='series') renderSLS(d,extra);
          else if(act==='episode') playSLE(d.embed_url,d.server_buttons||[]);
          return;
        }
        if(d.state==='error'){ setSLSt('Error: '+(d.error||'Desconocido'), false); toast(d.error||'Error', 'error'); return; }
        loop(i+1);
      }).catch(function(e){
        if(i < 3) loop(i+1); // retry on network errors
        else setSLSt('Error de conexión. Intentá de nuevo.', false);
      });
    }, delay);
  })(0);
}
function renderSLR(results){
  var g=document.getElementById('slResults'); g.innerHTML='';
  if(!results.length){g.innerHTML='<div style="color:var(--mt);padding:1rem">Sin resultados.</div>'; return;}
  results.forEach(function(it){
    var c=document.createElement('div'); c.className='sl-card';
    c.innerHTML=(it.poster?'<img src="'+it.poster+'" alt="'+esc(it.title)+'" loading="lazy" onerror="this.style.display=\'none\'"/>':'<div style="aspect-ratio:2/3;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:2rem">🎬</div>')+
      '<div class="sl-info"><div class="sl-title">'+esc(it.title)+'</div><div class="sl-year">'+esc(it.year||it.badge||'')+'</div></div>';
    c.onclick=function(){ loadSLI(it); }; g.appendChild(c);
  });
}
