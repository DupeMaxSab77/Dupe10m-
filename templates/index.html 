  }).then(function(){
    radioLoadYtUrl(url);
    // Remove from lists locally
    document.querySelectorAll('[data-url="'+url+'"]').forEach(function(el){el.remove();});
  });
}

function radioClearSuggestion(url, btn){
  fetchT(BASE + '/api/radio/clear-suggestion', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({url: url})
  });
  // Remove el
  var el = btn ? btn.closest('[data-url]') : null;
  if(el) el.remove();
  document.querySelectorAll('#radioSuggestionsPublicList [data-url="'+url+'"]').forEach(function(e){e.remove();});
}

function radioLoadYt(){
  var url = document.getElementById('radioYtInput').value.trim();
  if(!url) return;
  radioLoadYtUrl(url);
}

function radioLoadYtUrl(url){
  // Extract video ID
  var match = url.match(/(?:v=|youtu\.be\/|embed\/)([\w\-]{11})/);
  if(!match){ toast('Link de YouTube inválido', 'error'); return; }
  var vid = match[1];
  var iframe = document.getElementById('radioYtIframe');
  // Destroy old player
  _radioYtPlayer = null;
  // Load via IFrame API for volume control
  if(window.YT && window.YT.Player){
    iframe.id = 'radioYtIframe'; // ensure id
    _radioYtPlayer = new YT.Player('radioYtIframe', {
      videoId: vid,
      playerVars: {autoplay: 1, controls: 1, rel: 0},
      events: {
        onReady: function(e){
          e.target.setVolume(_radioDucking ? 20 : 100);
          e.target.playVideo();
        }
      }
    });
  } else {
    iframe.src = 'https://www.youtube.com/embed/' + vid + '?autoplay=1&rel=0';
  }
  document.getElementById('radioYtInput').value = url;
}

function radioToggleMute(){
  _radioMuted = !_radioMuted;
  document.getElementById('radioMuteBtn').textContent = _radioMuted ? '🔇' : '🔊';
  if(_radioYtPlayer && _radioYtPlayer.setVolume){
    _radioYtPlayer.setVolume(_radioMuted ? 0 : (_radioDucking ? 20 : 100));
  } else {
    var iframe = document.getElementById('radioYtIframe');
    iframe.contentWindow && iframe.contentWindow.postMessage('{"event":"command","func":"'
      + (_radioMuted ? 'mute' : 'unMute') + '","args":""}', '*');
  }
}

