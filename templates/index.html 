function toggleSI(){ var i=document.getElementById('hsi'); i.classList.toggle('op'); if(i.classList.contains('op')) i.focus(); }
function hsiSearch(){ var q=document.getElementById('hsi').value.trim(); if(!q) return; document.getElementById('srchInp').value=q; show('search'); doSearch(); }
function doSearch(page){
  page=page||1;
  var q=document.getElementById('srchInp').value.trim();
  var t=document.getElementById('srchType').value;
  t=normType(t);
  if(!q||q.length<2) return;
  S.sq=q; S.st=t; S.sp=page;
  document.getElementById('rgrid').innerHTML='<div style="color:var(--mt);padding:1rem">Buscando...</div>';
  document.getElementById('rcnt').innerHTML=''; document.getElementById('pgn').innerHTML='';

  if(STANDALONE){
    // FIX: Determine correct media type based on search endpoint
    var searchType = t || 'multi';
    var url='https://api.themoviedb.org/3/search/'+searchType+'?api_key='+S.TMDB+'&query='+encodeURIComponent(q)+'&page='+page;
    fetch(url).then(function(r){return r.json();}).then(function(d){
      var results=[];
      if(d.results){
        d.results.forEach(function(it){
          if(it.media_type==='person') return;
          // FIX: Use searchType as default when media_type is missing (TV/movie endpoints don't include it)
          var mt=normType(it.media_type || searchType);
          results.push({tmdb_id:it.id, title:it.title||it.name||'', poster:it.poster_path?S.TIMG+'/w300'+it.poster_path:'', year:(it.release_date||it.first_air_date||'').slice(0,4), vote:it.vote_average||0, type:mt, totalSeasons:it.number_of_seasons||null});
        });
      }
      S.stotal=d.total_results||0; S.stotalP=d.total_pages||1;
      document.getElementById('rcnt').innerHTML='<strong>'+(results.length)+'</strong> resultados para "'+esc(q)+'"'+(t?' ('+dispType(t)+')':'');
      var g=document.getElementById('rgrid'); g.innerHTML='';
      if(!results.length){g.innerHTML='<div style="color:var(--mt);padding:1rem">Sin resultados.</div>'; return;}
      results.forEach(function(it){ g.appendChild(mkCard(it)); });
      buildPgn(page, S.stotalP);
    }).catch(function(e){document.getElementById('rgrid').innerHTML='<div style="color:var(--mt);padding:1rem">Error: '+e.message+'</div>';});
    return;
  }

  fetchT(BASE+'/api/tmdb-search?q='+encodeURIComponent(q)+'&type='+t+'&page='+page, {}, 12000)
  .then(function(r){ if(!r.ok) throw new Error('Error del servidor ('+r.status+')'); return r.json(); })
  .then(function(d){
    if(d.success){
      S.stotal=d.total; S.stotalP=d.total_pages;
      var results = d.results.filter(function(it){ var mt=normType(it.type); return !t || mt===t; });
      document.getElementById('rcnt').innerHTML='<strong>'+results.length+'</strong> resultado'+(results.length!==1?'s':'')+' para "'+esc(q)+'"'+(t?' ('+dispType(t)+')':'');
      var g=document.getElementById('rgrid'); g.innerHTML='';
      if(!results.length){g.innerHTML='<div style="color:var(--mt);padding:1rem;font-size:.85rem">Sin resultados para "'+esc(q)+'"'+(t?' en '+dispType(t):'')+'.</div>'; return;}
      results.forEach(function(it){ it.type=normType(it.type); g.appendChild(mkCard(it)); });
      buildPgn(page, d.total_pages);
    } else {
      document.getElementById('rgrid').innerHTML='<div style="color:var(--mt);padding:1rem;font-size:.85rem">'+esc(d.error||'Sin resultados.')+'</div>';
    }
  }).catch(function(e){
    var msg = e.name==='AbortError' ? 'La búsqueda tardó demasiado. Intentá de nuevo.' : ('Error: '+e.message);
    document.getElementById('rgrid').innerHTML='<div style="color:#f87171;padding:1rem;font-size:.85rem">'+esc(msg)+'</div>';
  });
}
function buildPgn(cur, total){
  var el=document.getElementById('pgn'); el.innerHTML=''; if(total<=1) return;
  var st=Math.max(1,cur-2), en=Math.min(total,st+4);
  if(cur>1){var b=document.createElement('button');b.className='pb';b.innerHTML='<i class="fa-solid fa-chevron-left" style="font-size:.6rem"></i>';b.onclick=function(){doSearch(cur-1);};el.appendChild(b);}
  for(var p=st;p<=en;p++){(function(pp){var b=document.createElement('button');b.className='pb'+(pp===cur?' cur':'');b.textContent=pp;b.onclick=function(){doSearch(pp);};el.appendChild(b);})(p);}
  if(cur<total){var b=document.createElement('button');b.className='pb';b.innerHTML='<i class="fa-solid fa-chevron-right" style="font-size:.6rem"></i>';b.onclick=function(){doSearch(cur+1);};el.appendChild(b);}
}

