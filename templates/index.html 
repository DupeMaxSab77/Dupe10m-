// ===================== PROGRESS / HISTORY =====================
function getProgress(id){
  if(!S.prof) return null;
  return (S.prof.watch_progress||{})[String(id)] || null;
}
function saveProgress(item,s,e){
  if(!S.prof||STANDALONE) return;
  var p={season:s,episode:e};
  if(!S.prof.watch_progress) S.prof.watch_progress={};
  S.prof.watch_progress[String(item.tmdb_id)]=p;
  fetch(BASE+'/api/progress/save', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({profile_id:S.prof.id, tmdb_id:item.tmdb_id, progress:p})
  }).catch(function(){});
}
function addHist(item,s,e){
  if(!S.prof) return;
  var entry={tmdb_id:item.tmdb_id,title:item.title,poster:item.poster,type:item.type,year:item.year,season:s,episode:e};
  var h=S.prof.history||[];
  h=h.filter(function(x){return String(x.tmdb_id)!==String(item.tmdb_id);});
  h.unshift(entry);
  S.prof.history=h.slice(0,80);
  if(STANDALONE){ _saveProfiles(); return; }
  fetch(BASE+'/api/history/add', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({profile_id:S.prof.id, item:entry})
  }).catch(function(){});
}
