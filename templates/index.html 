<script>
// ═══════════════════ MULTI-SITE SEARCH ═══════════════════════════════
var _msResults = [], _msFilt = 'all', _msRunning = false;

function multiSearchFocus(){
  var el = document.getElementById('msInp');
  if(el) el.focus();
}

function msSearch(){
  var q = (document.getElementById('msInp').value || '').trim();
  if(!q || _msRunning) return;
  _msRunning = true;

  var btn = document.getElementById('msBtn');
  btn.disabled = true; btn.textContent = '⏳ Buscando…';
  document.getElementById('msStat').textContent = 'Consultando 10 sitios en paralelo…';
  document.getElementById('msFilters').style.display = 'none';
  document.getElementById('msGrid').innerHTML = [0,1,2,3,4,5].map(function(){
    return '<div class="sk" style="border-radius:10px"><div class="sk-poster sk"></div><div class="sk-text sk"></div><div class="sk-text2 sk"></div></div>';
  }).join('');

  // Show searching state on site badges
  document.querySelectorAll('.ms-site').forEach(function(s){ s.className='ms-site searching'; });

  fetch('/api/multi-search', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({query: q})
  }).then(function(r){ return r.json(); }).then(function(d){
    _msRunning = false;
    btn.disabled = false; btn.textContent = '🔍 Buscar en todos';
    document.querySelectorAll('.ms-site').forEach(function(s){ s.className='ms-site ok'; });

    if(!d.ok){ 
      document.getElementById('msStat').textContent = 'Error: ' + d.error;
      document.getElementById('msGrid').innerHTML = '<div class="ms-empty">'+d.error+'</div>';
      return;
    }
    _msResults = d.results || [];
    var total = _msResults.length;
    document.getElementById('msStat').textContent = total + ' resultados encontrados en los 10 sitios';
    document.getElementById('msFilters').style.display = total ? 'flex' : 'none';
    msRender();

    // Mark which sites returned results
    var foundSites = new Set(_msResults.map(function(r){ return r.source; }));
    document.querySelectorAll('.ms-site').forEach(function(s){
      s.className = 'ms-site ' + (foundSites.has(s.dataset.site) ? 'ok' : '');
    });
  }).catch(function(e){
    _msRunning = false;
    btn.disabled = false; btn.textContent = '🔍 Buscar en todos';
    document.querySelectorAll('.ms-site').forEach(function(s){ s.className='ms-site'; });
    document.getElementById('msStat').textContent = 'Error de conexión: ' + e.message;
    document.getElementById('msGrid').innerHTML = '<div class="ms-empty" style="color:#ef4444">'+e.message+'</div>';
  });
}

function msFilt(btn){
  document.querySelectorAll('.ms-flt').forEach(function(b){ b.classList.remove('on'); });
  btn.classList.add('on');
  _msFilt = btn.dataset.type;
  msRender();
}

function msRender(){
  var items = _msResults;
  if(_msFilt !== 'all') items = items.filter(function(r){ return r.type === _msFilt; });
  var grid = document.getElementById('msGrid');
  if(!items.length){
    grid.innerHTML = '<div class="ms-empty">Sin resultados' + (_msFilt!=='all'?' para este filtro':'') + '</div>';
    return;
  }
  var frag = document.createDocumentFragment();
  items.forEach(function(r){
    var a = document.createElement('a');
    a.className = 'ms-card';
    a.href = r.url; a.target = '_blank'; a.rel = 'noopener noreferrer';
    var posterHtml = r.poster
      ? '<img class="ms-poster" src="'+msEsc(r.poster)+'" loading="lazy" onerror="this.parentElement.innerHTML='<div class=ms-poster-ph>🎬</div>'">'
      : '<div class="ms-poster-ph">🎬</div>';
    var typeIcon = r.type === 'Serie' ? '🎭' : '🎬';
    a.innerHTML = posterHtml +
      '<div class="ms-card-info">' +
        '<div class="ms-card-title">'+msEsc(r.title)+'</div>'+
        '<div class="ms-card-meta">'+
          (r.year ? '<span class="ms-badge">'+msEsc(r.year)+'</span>' : '')+
          '<span class="ms-badge">'+typeIcon+' '+msEsc(r.type||'')+'</span>'+
          '<span class="ms-badge src">'+msEsc(r.source)+'</span>'+
          (r.quality ? '<span class="ms-badge">'+msEsc(r.quality)+'</span>' : '')+
        '</div>'+
      '</div>';
    frag.appendChild(a);
  });
  grid.innerHTML = ''; grid.appendChild(frag);
}

function msEsc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ═══════════════════════════════════════════════════════════
//  TV MODE — Remote Control with VidFast PostMessage API
// ═══════════════════════════════════════════════════════════
(function(){
  'use strict';

  var _tvOn = false;
  var _tvMuted = false;
  var _tvPlaying = false;
  var _tvDuration = 0;
  var _tvCurrentTime = 0;
  var _tvStatusInterval = null;
  var _tvPauseTimeout = null;
  var _tvRemoteOpen = false;
  var _tvKbBound = false;

  // ── Get the active VidFast iframe ──
  function _tvGetIframe(){
    // Only work with pif when playing VidFast (srcIdx===4)
    var pif = document.getElementById('pif');
    if(pif && pif.src && pif.src.indexOf('vidfast') > -1) return pif;
    return null;
  }

  // ── Send a PostMessage command to VidFast ──
  function tvCmd(command, extra){
    var iframe = _tvGetIframe();
    if(!iframe){
      _tvSetStatus('⚠️ No hay reproductor VidFast activo');
      return;
    }
    var msg = Object.assign({ command: command }, extra || {});
    iframe.contentWindow.postMessage(msg, '*');
  }
  window.tvCmd = tvCmd;

  // ── OK button / Enter key → toggle pause/play ──
  function tvOk(){
    var iframe = _tvGetIframe();
    if(!iframe){
      // If not on player, do nothing special
      _tvSetStatus('⚠️ Abrí un video con VidFast primero');
      return;
    }
    if(_tvPlaying){
      tvCmd('pause');
      _tvShowPauseOverlay(true);
    } else {
      tvCmd('play');
      _tvShowPauseOverlay(false);
    }
    _tvPlaying = !_tvPlaying;
    _tvUpdateOkBtn();
    tvGetStatus();
  }
  window.tvOk = tvOk;

  // ── D-pad navigation ──
  function tvDpad(dir){
    var iframe = _tvGetIframe();
    if(dir === 'left'){
      // Seek back 10s
      if(iframe) tvCmd('seek', { time: Math.max(0, _tvCurrentTime - 10) });
    } else if(dir === 'right'){
      // Seek forward 10s
      if(iframe) tvCmd('seek', { time: _tvCurrentTime + 10 });
    } else if(dir === 'up'){
      // Volume up 10%
      var newVol = Math.min(1, (parseInt(document.getElementById('tvVol').value) + 10) / 100);
      tvSetVolume(newVol);
      document.getElementById('tvVol').value = Math.round(newVol * 100);
    } else if(dir === 'down'){
      // Volume down 10%
      var newVol2 = Math.max(0, (parseInt(document.getElementById('tvVol').value) - 10) / 100);
      tvSetVolume(newVol2);
      document.getElementById('tvVol').value = Math.round(newVol2 * 100);
    }
    // Visual feedback
    _tvBtnFlash(dir);
  }
  window.tvDpad = tvDpad;

  // ── Volume ──
  function tvSetVolume(level){
    level = Math.max(0, Math.min(1, level));
    tvCmd('volume', { level: level });
    document.getElementById('tvVolVal').textContent = Math.round(level * 100);
    document.getElementById('tvVol').value = Math.round(level * 100);
  }
  window.tvSetVolume = tvSetVolume;

  // ── Mute toggle ──
  function tvMuteToggle(){
    _tvMuted = !_tvMuted;
    tvCmd('mute', { muted: _tvMuted });
    var ico = document.getElementById('tvMuteIco');
    if(ico) ico.className = _tvMuted ? 'fa-solid fa-volume-xmark' : 'fa-solid fa-volume-high';
    _tvSetStatus(_tvMuted ? '🔇 Silenciado' : '🔊 Audio activado');
  }
  window.tvMuteToggle = tvMuteToggle;

  // ── Seek ──
  function tvSeekTo(pct){
    if(!_tvDuration) return;
    var t = (_tvDuration * pct) / 100;
    tvCmd('seek', { time: t });
    _tvCurrentTime = t;
    _tvSetStatus('⏩ ' + _tvFmtTime(t) + ' / ' + _tvFmtTime(_tvDuration));
  }
  window.tvSeekTo = tvSeekTo;

  // ── Request status from player ──
  function tvGetStatus(){
    tvCmd('getStatus');
  }
  window.tvGetStatus = tvGetStatus;

  // ── Toggle TV Mode on/off ──
  function tvToggle(){
    _tvOn = !_tvOn;
    var btn = document.getElementById('tvToggleBtn');
    var remote = document.getElementById('tvRemote');
    document.body.classList.toggle('tv-mode', _tvOn);
    btn.classList.toggle('tv-active', _tvOn);

    if(_tvOn){
      // Force VidFast source if on player screen
      if(S.curItem && S.srcIdx !== 4){
        S.srcIdx = 4;
        _applySource();
        _tvSetStatus('🎬 Fuente cambiada a VidFast');
      } else if(!S.curItem){
        _tvSetStatus('Seleccioná un video para controlar');
      }
      // Open remote
      _tvRemoteOpen = true;
      remote.classList.add('open');
      // Start polling
      _tvStartPolling();
      // Bind keyboard
      if(!_tvKbBound){ _tvKbBound = true; document.addEventListener('keydown', _tvKeydown, true); }
      tvGetStatus();
    } else {
      _tvRemoteOpen = false;
      remote.classList.remove('open');
      _tvStopPolling();
      _tvShowPauseOverlay(false);
    }
  }
  window.tvToggle = tvToggle;

  // ── Keyboard handler ──
  function _tvKeydown(e){
    if(!_tvOn) return;
    var tag = (e.target && e.target.tagName) || '';
    if(tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

    switch(e.key){
      case 'Enter': case ' ':
        e.preventDefault(); tvOk(); break;
      case 'ArrowLeft':
        e.preventDefault(); tvDpad('left'); break;
      case 'ArrowRight':
        e.preventDefault(); tvDpad('right'); break;
      case 'ArrowUp':
        e.preventDefault(); tvDpad('up'); break;
      case 'ArrowDown':
        e.preventDefault(); tvDpad('down'); break;
      case 'm': case 'M':
        tvMuteToggle(); break;
      case 'Escape':
        tvToggle(); break;
    }
  }

  // ── Status polling ──
  function _tvStartPolling(){
    _tvStopPolling();
    _tvStatusInterval = setInterval(function(){
      if(_tvOn) tvGetStatus();
    }, 3000);
  }
  function _tvStopPolling(){ if(_tvStatusInterval){ clearInterval(_tvStatusInterval); _tvStatusInterval = null; } }

  // ── Listen for PostMessage responses from VidFast ──
  window.addEventListener('message', function(evt){
    var data = evt.data;
    if(!data || data.type !== 'PLAYER_EVENT') return;
    var d = data.data || {};
    if(d.event === 'playerstatus'){
      _tvCurrentTime = d.currentTime || 0;
      _tvDuration = d.duration || 0;
      _tvPlaying = !!d.playing;
      _tvMuted = !!d.muted;
      var vol = (d.volume !== undefined) ? d.volume : 1;

      // Update seek bar
      if(_tvDuration > 0){
        var pct = (_tvCurrentTime / _tvDuration) * 100;
        document.getElementById('tvSeek').value = pct;
        document.getElementById('tvSeek').max = 100;
      }
      // Update time labels
      document.getElementById('tvCurTime').textContent = _tvFmtTime(_tvCurrentTime);
      document.getElementById('tvDurTime').textContent = _tvFmtTime(_tvDuration);
      // Update volume
      var volPct = Math.round(vol * 100);
      document.getElementById('tvVol').value = volPct;
      document.getElementById('tvVolVal').textContent = volPct;
      // Update mute icon
      var ico = document.getElementById('tvMuteIco');
      if(ico) ico.className = _tvMuted ? 'fa-solid fa-volume-xmark' : 'fa-solid fa-volume-high';
      // Update status dot & text
      _tvUpdateDot();
      _tvSetStatus(
        (_tvPlaying ? '▶ Reproduciendo' : '⏸ Pausado') +
        ' · ' + _tvFmtTime(_tvCurrentTime) + ' / ' + _tvFmtTime(_tvDuration)
      );
      _tvUpdateOkBtn();
    }
  });

  function _tvUpdateDot(){
    var dot = document.getElementById('tvDot');
    if(!dot) return;
    dot.className = 'tv-status-dot' + (_tvPlaying ? ' playing' : (_tvCurrentTime > 0 ? ' paused' : ''));
  }
  function _tvUpdateOkBtn(){
    var btn = document.getElementById('tvOkBtn');
    if(btn) btn.textContent = _tvPlaying ? '⏸' : '▶';
  }
  function _tvSetStatus(txt){
    var el = document.getElementById('tvStatusTxt');
    if(el) el.textContent = txt;
  }

  // ── Pause overlay ──
  function _tvShowPauseOverlay(isPaused){
    var ov = document.getElementById('tvPauseOverlay');
    var ico = document.getElementById('tvPauseIcon');
    if(!ov) return;
    if(isPaused){
      ico.innerHTML = '<i class="fa-solid fa-pause"></i>';
    } else {
      ico.innerHTML = '<i class="fa-solid fa-play"></i>';
    }
    ov.classList.add('show');
    if(_tvPauseTimeout) clearTimeout(_tvPauseTimeout);
    _tvPauseTimeout = setTimeout(function(){ ov.classList.remove('show'); }, 1200);
  }

  // ── Visual button flash ──
  function _tvBtnFlash(dir){
    var map = { up:'.dpad-up', down:'.dpad-down', left:'.dpad-left', right:'.dpad-right' };
    var el = document.querySelector(map[dir]);
    if(!el) return;
    el.classList.add('pressed');
    setTimeout(function(){ el.classList.remove('pressed'); }, 150);
  }

  // ── Time formatter ──
  function _tvFmtTime(sec){
    if(!sec || isNaN(sec)) return '0:00';
    sec = Math.floor(sec);
    var h = Math.floor(sec / 3600);
    var m = Math.floor((sec % 3600) / 60);
    var s = sec % 60;
    if(h > 0) return h + ':' + (m<10?'0':'') + m + ':' + (s<10?'0':'') + s;
    return m + ':' + (s<10?'0':'') + s;
  }

  // ── Hook into playItem to auto-switch to VidFast when TV mode is on ──
  var _origPlayItem = window.playItem;
  if(typeof _origPlayItem === 'function'){
    window.playItem = function(item){
      _origPlayItem(item);
      if(_tvOn && S.srcIdx !== 4){
        setTimeout(function(){
          S.srcIdx = 4;
          _applySource();
          _tvSetStatus('🎬 VidFast activado para TV Mode');
          setTimeout(tvGetStatus, 2000);
        }, 300);
      }
    };
  }

})();

// ═══════════════════ CANALES IPTV ══════════════════════════════════
var _icG={}, _icCat='__all__', _icQ='', _icOpened=false, _icHls=null;

function iptvOpen(){
  if(!_icOpened){ _icOpened=true; icLoad(); }
}

function icLoad(){
  fetch('/api/iptv/channels').then(function(r){
    if(!r.ok) throw new Error('HTTP '+r.status+' — reiniciá el servidor con ./start_all.sh');
    return r.json();
  }).then(function(d){
    _icG = d.groups||{};
    var total = d.total||0;
    document.getElementById('icCount').textContent = total+' canales';
    var cats = document.getElementById('icCats');
    cats.querySelectorAll('.ic-cat:not([data-cat="__all__"])').forEach(function(b){b.remove();});
    var ICONS={General:'📺',News:'📰',Sports:'⚽',Movies:'🎬',Series:'🎭',Entertainment:'🎪',Music:'🎵',Kids:'🧸',Animation:'🌸',Documentary:'🎥',Education:'📚',Religious:'✝️',Culture:'🎨',Classic:'🎞️',Comedy:'😄',Cooking:'🍳',Outdoor:'🌲'};
    Object.keys(_icG).forEach(function(cat){
      var b=document.createElement('button');
      b.className='ic-cat'; b.dataset.cat=cat;
      b.onclick=function(){icCat(this);};
      b.textContent=(ICONS[cat]||'📁')+' '+cat+' '+_icG[cat].length;
      cats.appendChild(b);
    });
    icRender();
  }).catch(function(e){
    document.getElementById('icGrid').innerHTML='<div style="grid-column:1/-1;padding:30px;text-align:center;color:#ef4444;font-size:13px">'+e.message+'<br><br><button onclick="icLoad()" style="background:var(--acc);border:none;color:#fff;padding:7px 16px;border-radius:6px;cursor:pointer;font-size:12px;font-family:inherit">Reintentar</button></div>';
    document.getElementById('icCount').textContent='Error';
  });
}

function icCat(btn){
  document.getElementById('icCats').querySelectorAll('.ic-cat').forEach(function(b){b.classList.remove('on');});
  btn.classList.add('on'); _icCat=btn.dataset.cat;
  document.getElementById('icSrch').value=''; _icQ=''; icRender();
}
function icFilter(){ _icQ=document.getElementById('icSrch').value.toLowerCase().trim(); icRender(); }

function icRender(){
  var chs=[];
  if(_icCat==='__all__') Object.values(_icG).forEach(function(a){chs=chs.concat(a);});
  else chs=_icG[_icCat]||[];
  if(_icQ) chs=chs.filter(function(c){return c.name.toLowerCase().indexOf(_icQ)>-1;});
  document.getElementById('icCount').textContent=chs.length+' canales';
  var grid=document.getElementById('icGrid');
  if(!chs.length){grid.innerHTML='<div style="grid-column:1/-1;padding:30px;text-align:center;color:#555;font-size:13px">Sin resultados</div>';return;}
  var frag=document.createDocumentFragment();
  chs.slice(0,600).forEach(function(ch){
    var d=document.createElement('div'); d.className='ic-card';
    var ini=(ch.name||'?').substring(0,2).toUpperCase();
    var lg=ch.logo?'<div class="ic-logo"><img src="'+icEsc(ch.logo)+'" onerror="this.parentElement.textContent=\''+ini+'\'" loading="lazy"></div>':'<div class="ic-logo">'+ini+'</div>';
    d.innerHTML=lg+'<div style="flex:1;min-width:0"><div class="ic-name">'+icEsc(ch.name)+'</div><div class="ic-grp">'+icEsc(ch.group||ch.source||'')+'</div></div><button class="ic-copy" onclick="icCopy(this,\''+icEsc(ch.url)+'\',event)">Copiar</button>';
    d.onclick=function(e){if(!e.target.classList.contains('ic-copy'))icPlay(ch);};
    frag.appendChild(d);
  });
  grid.innerHTML=''; grid.appendChild(frag);
  if(chs.length>600){var n=document.createElement('div');n.style.cssText='grid-column:1/-1;padding:8px;text-align:center;font-size:11px;color:#444';n.textContent='Mostrando 600 de '+chs.length+' — usá la búsqueda';grid.appendChild(n);}
}

function icEsc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}

function icCopy(btn,url,e){
  e.stopPropagation();
  navigator.clipboard.writeText(url).catch(function(){var t=document.createElement('textarea');t.value=url;t.style='position:fixed;opacity:0';document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);});
  btn.textContent='✓'; btn.classList.add('ic-copied');
  setTimeout(function(){btn.textContent='Copiar';btn.classList.remove('ic-copied');},2000);
}

function icPlay(ch){
  var ex=document.getElementById('icModal'); if(ex) ex.remove();
  if(_icHls){_icHls.destroy();_icHls=null;}
  var m=document.createElement('div'); m.id='icModal';
  m.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.93);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:12px';
  m.innerHTML='<div style="width:100%;max-width:840px"><div style="display:flex;align-items:center;gap:10px;margin-bottom:8px"><div style="flex:1;font-size:15px;font-weight:700;color:#fff">'+icEsc(ch.name)+'</div><button onclick="var m=document.getElementById('icModal');if(m._hls)m._hls.destroy();m.remove()" style="background:#1a1a1a;border:1px solid #333;color:#aaa;padding:5px 14px;border-radius:6px;cursor:pointer;font-size:13px;font-family:inherit">✕</button></div><video id="icVid" controls autoplay playsinline style="width:100%;border-radius:10px;background:#000;max-height:65vh"></video><div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap"><input readonly value="'+icEsc(ch.url)+'" style="flex:1;min-width:0;background:#1a1a1a;border:1px solid #333;color:#888;font-size:11px;padding:6px 10px;border-radius:6px;outline:none;font-family:monospace"><button onclick="icCopy(this,''+icEsc(ch.url)+'',event)" class="ic-copy" style="background:var(--acc);border:none;color:#fff;padding:6px 14px;border-radius:6px;cursor:pointer;font-size:12px;font-family:inherit">Copiar link</button><a href="'+icEsc(ch.url)+'" target="_blank" style="background:#1a1a1a;border:1px solid #333;color:#aaa;padding:6px 14px;border-radius:6px;font-size:12px;font-family:inherit;text-decoration:none">Nueva pestaña</a></div></div>';
  document.body.appendChild(m);
  m.onclick=function(e){if(e.target===m){if(m._hls)m._hls.destroy();m.remove();}};
  var vid=document.getElementById('icVid');
  var isHls=/\.m3u8?(\?|$)/i.test(ch.url)||!ch.url.match(/\.(mp4|ts)(\?|$)/i);
  if(isHls&&typeof Hls!=='undefined'&&Hls.isSupported()){
    var h=new Hls({maxBufferLength:20}); h.loadSource(ch.url); h.attachMedia(vid);
    h.on(Hls.Events.MANIFEST_PARSED,function(){vid.play().catch(function(){});});
    m._hls=h; _icHls=h;
  } else { vid.src=ch.url; vid.play().catch(function(){}); }
}


</script>


